# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo como '.env' en la raíz del proyecto y completa con tus valores locales.
# ==============================================================================

# Cadenas de conexión a Bases de Datos (SQL Server 2025 localhost)
DBOptions__ConnectionString="Server=localhost;Database=NorthWindDB;Trusted_Connection=True;TrustServerCertificate=True;"
DBOptions__DomainLogsConnectionString="Server=localhost;Database=NorthWindLogsDB;Trusted_Connection=True;TrustServerCertificate=True;"
MembershipDB__ConnectionString="Server=localhost;Database=NorthWindUsersDB;Trusted_Connection=True;TrustServerCertificate=True;"
MembershipDBOptions__ConnectionString="Server=localhost;Database=NorthWindUsersDB;Trusted_Connection=True;TrustServerCertificate=True;"

# JWT Autenticación
Jwt__SecretKey="TuClaveSecretaMinimo32CaracteresDePruebaAqui!!"
Jwt__Issuer="NorthWindAuthServer"
Jwt__Audience="NorthWindClient"
Jwt__ExpirationMinutes=60

# Configuración de Servidor de Correo (SMTP - Mailtrap / Servidor real)
Smtp__Host="sandbox.smtp.mailtrap.io"
Smtp__Port=2525
Smtp__From="noreply@northwind.com"
Smtp__AdministratorEmail="admin@northwind.com"
Smtp__UserName="tu_usuario_mailtrap"
Smtp__Password="tu_password_mailtrap"
Smtp__EnableSsl=true
