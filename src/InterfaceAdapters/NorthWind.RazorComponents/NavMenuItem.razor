<div class="nav-item px-2 my-1">
    <NavLink class="nav-link custom-nav-link d-flex align-items-center justify-content-between px-3 py-2 rounded-3" href="@Href" Match="@Match">
        <div class="d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(IconClass))
            {
                <span class="nav-icon-container d-inline-flex align-items-center justify-content-center">
                    <i class="@IconClass" aria-hidden="true"></i>
                </span>
            }
            <span class="nav-label">@ChildContent</span>
        </div>
        @if (!string.IsNullOrEmpty(BadgeText))
        {
            <span class="badge @BadgeClass">@BadgeText</span>
        }
    </NavLink>
</div>
