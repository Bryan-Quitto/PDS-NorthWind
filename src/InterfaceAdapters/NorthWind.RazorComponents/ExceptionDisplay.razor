@if (Exception != null)
{
    var errors = GetValidationErrors();
    @if (errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <h6 class="alert-heading fw-bold">Por favor corrija los siguientes errores:</h6>
            <ul class="mb-0 ps-3">
                @foreach (var error in errors)
                {
                    <li>
                        @if (!string.IsNullOrWhiteSpace(error.PropertyName))
                        {
                            var friendlyName = GetFriendlyPropertyName(error.PropertyName);
                            if (!string.IsNullOrWhiteSpace(friendlyName))
                            {
                                <strong>@friendlyName: </strong>
                            }
                        }
                        @error.ErrorMessage
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <h6 class="alert-heading fw-bold">Ha ocurrido un error</h6>
            <p class="mb-0">@Exception.Message</p>
        </div>
    }
}

@code {
    [Parameter]
    public Exception? Exception { get; set; }

    private IReadOnlyList<ValidationError> GetValidationErrors()
    {
        if (Exception == null) return [];

        if (Exception.Data.Contains("Errors"))
        {
            var dataErrors = Exception.Data["Errors"];

            if (dataErrors is IEnumerable<ValidationError> validationErrors)
            {
                return validationErrors.ToList();
            }

            if (dataErrors is IEnumerable<string> stringErrors)
            {
                return stringErrors.Select(msg => new ValidationError(string.Empty, msg)).ToList();
            }

            if (dataErrors is IDictionary<string, string[]> dictErrors)
            {
                return dictErrors
                    .SelectMany(kvp => kvp.Value.Select(msg => new ValidationError(kvp.Key, msg)))
                    .ToList();
            }
        }

        return [];
    }

    private static string GetFriendlyPropertyName(string propertyName)
    {
        if (string.IsNullOrWhiteSpace(propertyName)) return string.Empty;

        // Si es una ruta técnica de colección como OrderDetails[0].Quantity o OrderDetails[0].ProductId
        if (propertyName.StartsWith("OrderDetails[", StringComparison.OrdinalIgnoreCase))
        {
            var match = System.Text.RegularExpressions.Regex.Match(propertyName, @"OrderDetails\[(\d+)\](?:\.(\w+))?", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (match.Success)
            {
                var itemNumber = int.Parse(match.Groups[1].Value) + 1;
                var subProp = match.Groups[2].Success ? match.Groups[2].Value : string.Empty;

                return subProp.ToLowerInvariant() switch
                {
                    "quantity" => $"Ítem #{itemNumber} (Cantidad)",
                    "productid" => $"Ítem #{itemNumber} (Producto)",
                    "unitprice" => $"Ítem #{itemNumber} (Precio Unitario)",
                    _ => $"Ítem #{itemNumber}"
                };
            }
        }

        return propertyName.ToLowerInvariant() switch
        {
            "customerid" => "Cliente",
            "customername" => "Nombre del Cliente",
            "customeridentification" => "Identificación",
            "shipaddress" => "Dirección de Envío",
            "shipcity" => "Ciudad de Envío",
            "shipcountry" => "País de Envío",
            "shippostalcode" => "Código Postal",
            "orderdetails" => "Detalle de Productos",
            "firstname" => "Nombre",
            "lastname" => "Apellido",
            "email" => "Correo Electrónico",
            "password" => "Contraseña",
            "passwordconfirmation" => "Confirmación de Contraseña",
            _ => propertyName
        };
    }
}
