@namespace NorthWind.Sales.Frontend.Views.Components

<div class="row justify-content-end mb-4">
    <div class="col-md-5 col-lg-4">
        <div class="card bg-light border-0 shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">@ViewMessages.SubtotalAmountLabel</span>
                    <span class="font-monospace fw-bold">@Subtotal.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">@ViewMessages.TaxAmountLabel</span>
                    <span class="font-monospace fw-bold">@Tax.ToString("C2")</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-primary">@ViewMessages.TotalAmountLabel</h5>
                    <h4 class="mb-0 font-monospace fw-bold text-success">@Total.ToString("C2")</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
    <div>
        <button type="button"
                class="btn btn-outline-danger btn-lg px-4"
                disabled="@IsSubmitting"
                @onclick="HandleOpenClearOrderModalAsync">
            <i class="bi bi-trash3 me-1"></i> Limpiar orden
        </button>
    </div>
    <div>
        <button type="submit" class="btn btn-primary btn-lg px-4" disabled="@(IsSubmitting || !CanSubmit)">
            @if (IsSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                @ViewMessages.SubmittingOrderButton
            }
            else
            {
                <i class="bi bi-check2-circle me-1"></i> @ViewMessages.SubmitOrderButton
            }
        </button>
    </div>
</div>
