@namespace NorthWind.Sales.Frontend.Views

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-cart-check-fill me-2"></i>@ViewMessages.CreateOrderTitle
        </h5>
    </div>
    <div class="card-body">
        <ExceptionDisplay Exception="@_currentException" />

        @if (_createdOrderId.HasValue)
        {
            <div class="alert alert-success d-flex align-items-center justify-content-between p-4" role="alert">
                <div>
                    <h4 class="alert-heading mb-2">@ViewMessages.OrderSuccessTitle</h4>
                    <p class="mb-0 fs-5">
                        @ViewMessages.OrderSuccessMessage <strong>#@_createdOrderId.Value</strong>
                    </p>
                </div>
                <button type="button" class="btn btn-success btn-lg" @onclick="ResetForm">
                    <i class="bi bi-plus-circle me-1"></i> @ViewMessages.CreateAnotherOrderButton
                </button>
            </div>
        }
        else
        {
            <EditForm EditContext="@_editContext" OnValidSubmit="HandleValidSubmit">
                <ModelValidator T="CreateOrderViewModel" />

                <!-- SECCIÓN MAESTRO: DATOS DEL CLIENTE -->
                <CustomerSectionCard Model="@Model"
                                     OnOpenCustomerModal="OpenCustomerModal"
                                     OnClearCustomer="HandleClearCustomer" />

                <!-- SECCIÓN MAESTRO: DATOS DE ENVÍO -->
                <ShippingAddressSection Model="@Model" />

                <!-- SECCIÓN DETALLE: PRODUCTOS DE LA ORDEN -->
                <OrderItemsTable Items="@Model.OrderDetails"
                                 OnOpenAddProductModal="OpenProductModal"
                                 OnOpenClearProductsModal="OpenClearProductsModal"
                                 OnReplaceProduct="OpenReplaceProductModal"
                                 OnRemoveProduct="HandleRemoveProduct"
                                 OnQuantityChanged="HandleQuantityChanged" />

                <!-- RESUMEN FINANCIERO Y TOTALES -->
                <OrderTotalsSummary Subtotal="@Model.Subtotal"
                                    Tax="@Model.Tax"
                                    Total="@Model.Total"
                                    IsSubmitting="@_isSubmitting"
                                    CanSubmit="@(Model.OrderDetails.Count > 0)"
                                    OnOpenClearOrderModal="OpenClearOrderModal" />
            </EditForm>
        }
    </div>
</div>

<!-- MODALES DE BÚSQUEDA -->
<CustomerSearchModal @bind-IsOpen="_isCustomerModalOpen"
                     OnCustomerSelected="HandleCustomerSelected" />

<ProductSearchModal @bind-IsOpen="_isProductModalOpen"
                    ExcludedProductId="_replacingProductId"
                    OnProductSelected="HandleProductSelected" />

<!-- MODALES DE CONFIRMACIÓN -->
<ConfirmActionDialog IsOpen="@_isClearProductsModalOpen"
                     IsOpenChanged="@((val) => _isClearProductsModalOpen = val)"
                     Title="Confirmar Limpieza de Productos"
                     Message="¿Está seguro de que desea eliminar todos los productos del detalle? La información del cliente y envío se mantendrá."
                     HeaderCssClass="bg-warning text-dark"
                     TitleTextCssClass="text-dark"
                     Icon="bi bi-exclamation-triangle-fill"
                     ConfirmButtonText="Sí, Limpiar Productos"
                     ConfirmButtonIcon="bi bi-trash3"
                     ConfirmButtonCssClass="btn-warning"
                     OnConfirm="ConfirmClearProducts"
                     OnCancel="CloseClearProductsModal" />

<ConfirmActionDialog IsOpen="@_isClearOrderModalOpen"
                     IsOpenChanged="@((val) => _isClearOrderModalOpen = val)"
                     Title="Confirmar Limpieza de Toda la Orden"
                     Message="¿Está seguro de que desea reiniciar toda la orden? Se borrarán los datos del cliente, envío y todos los productos agregados."
                     HeaderCssClass="bg-danger text-white"
                     TitleTextCssClass="text-white"
                     Icon="bi bi-exclamation-triangle-fill"
                     ConfirmButtonText="Sí, Limpiar Toda la Orden"
                     ConfirmButtonIcon="bi bi-trash3"
                     ConfirmButtonCssClass="btn-danger"
                     OnConfirm="ConfirmClearOrder"
                     OnCancel="CloseClearOrderModal" />
