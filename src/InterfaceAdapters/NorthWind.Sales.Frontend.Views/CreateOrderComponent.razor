<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-cart-check-fill me-2"></i>@ViewMessages.CreateOrderTitle
        </h5>
    </div>
    <div class="card-body">
        <ExceptionDisplay Exception="@_currentException" />

        @if (_createdOrderId.HasValue)
        {
            <div class="alert alert-success d-flex align-items-center justify-content-between p-4" role="alert">
                <div>
                    <h4 class="alert-heading mb-2">@ViewMessages.OrderSuccessTitle</h4>
                    <p class="mb-0 fs-5">
                        @ViewMessages.OrderSuccessMessage <strong>#@_createdOrderId.Value</strong>
                    </p>
                </div>
                <button type="button" class="btn btn-success btn-lg" @onclick="ResetForm">
                    <i class="bi bi-plus-circle me-1"></i> @ViewMessages.CreateAnotherOrderButton
                </button>
            </div>
        }
        else
        {
            <EditForm EditContext="@_editContext" OnValidSubmit="HandleValidSubmit">
                <ModelValidator T="CreateOrderViewModel" />

                <!-- SECCIÓN MAESTRO: DATOS DEL CLIENTE Y ENVÍO -->
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <span class="fw-bold text-primary">
                            <i class="bi bi-person-badge me-1"></i> @ViewMessages.CustomerSectionTitle
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenCustomerModal">
                            <i class="bi bi-search me-1"></i> @ViewMessages.SearchCustomerButton
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="customerId" class="form-label fw-bold">@ViewMessages.CustomerIdLabel</label>
                                <InputText id="customerId"
                                           class="form-control bg-light"
                                           @bind-Value="Model.CustomerId"
                                           placeholder="@ViewMessages.CustomerIdPlaceholder"
                                           readonly="true" />
                                <ValidationMessage For="@(() => Model.CustomerId)" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-4">
                                <label for="customerName" class="form-label fw-bold">@ViewMessages.CustomerNameLabel</label>
                                <input id="customerName"
                                       type="text"
                                       class="form-control bg-light"
                                       value="@Model.CustomerName"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label for="customerIdentification" class="form-label fw-bold">@ViewMessages.CustomerIdentificationLabel</label>
                                <input id="customerIdentification"
                                       type="text"
                                       class="form-control bg-light"
                                       value="@Model.CustomerIdentification"
                                       readonly />
                            </div>

                            <div class="col-md-2">
                                <label for="customerBalance" class="form-label fw-bold">@ViewMessages.CustomerBalanceLabel</label>
                                <input id="customerBalance"
                                       type="text"
                                       class="form-control bg-light font-monospace text-end"
                                       value="@(Model.CustomerBalance.HasValue ? Model.CustomerBalance.Value.ToString("C2") : string.Empty)"
                                       readonly />
                            </div>

                            <div class="col-md-6">
                                <label for="shipAddress" class="form-label fw-bold">@ViewMessages.ShipAddressLabel</label>
                                <InputText id="shipAddress" class="form-control" @bind-Value="Model.ShipAddress" />
                                <ValidationMessage For="@(() => Model.ShipAddress)" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-2">
                                <label for="shipCity" class="form-label fw-bold">@ViewMessages.ShipCityLabel</label>
                                <InputText id="shipCity" class="form-control" @bind-Value="Model.ShipCity" />
                                <ValidationMessage For="@(() => Model.ShipCity)" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-2">
                                <label for="shipCountry" class="form-label fw-bold">@ViewMessages.ShipCountryLabel</label>
                                <InputText id="shipCountry" class="form-control" @bind-Value="Model.ShipCountry" />
                                <ValidationMessage For="@(() => Model.ShipCountry)" class="text-danger small mt-1" />
                            </div>

                            <div class="col-md-2">
                                <label for="shipPostalCode" class="form-label fw-bold">@ViewMessages.ShipPostalCodeLabel</label>
                                <InputText id="shipPostalCode" class="form-control" @bind-Value="Model.ShipPostalCode" />
                                <ValidationMessage For="@(() => Model.ShipPostalCode)" class="text-danger small mt-1" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN DETALLE: PRODUCTOS DE LA ORDEN -->
                <div class="card mb-4 border-secondary">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-cart3 me-1"></i> @ViewMessages.OrderDetailsTitle
                        </span>
                        <button type="button" class="btn btn-sm btn-success" @onclick="OpenProductModal">
                            <i class="bi bi-plus-circle me-1"></i> @ViewMessages.AddProductButton
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.OrderDetails.Count == 0)
                        {
                            <div class="p-4 text-muted text-center">
                                <i class="bi bi-bag-x fs-1 text-secondary d-block mb-2"></i>
                                @ViewMessages.EmptyOrderDetailsWarning
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 8%;">@ViewMessages.ProductIdLabel</th>
                                            <th style="width: 37%;">@ViewMessages.ProductNameLabel</th>
                                            <th style="width: 15%;" class="text-end">@ViewMessages.UnitPriceLabel</th>
                                            <th style="width: 15%;" class="text-center">@ViewMessages.QuantityLabel</th>
                                            <th style="width: 15%;" class="text-end">@ViewMessages.SubtotalLineLabel</th>
                                            <th style="width: 10%;" class="text-center">@ViewMessages.ActionsLabel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detail in Model.OrderDetails)
                                        {
                                            <tr>
                                                <td class="text-muted fw-bold">
                                                    #@detail.ProductId
                                                </td>
                                                <td>
                                                    <input type="text"
                                                           class="form-control form-control-sm bg-light"
                                                           value="@detail.ProductName"
                                                           readonly />
                                                </td>
                                                <td>
                                                    <input type="text"
                                                           class="form-control form-control-sm bg-light text-end font-monospace"
                                                           value="@detail.UnitPrice.ToString("C2")"
                                                           readonly />
                                                    <ValidationMessage For="@(() => detail.UnitPrice)" class="text-danger small" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="number"
                                                           class="form-control form-control-sm text-center mx-auto"
                                                           style="max-width: 90px;"
                                                           min="1"
                                                           value="@detail.Quantity"
                                                           @onchange="(e) => OnQuantityChanged(detail, e)" />
                                                    <ValidationMessage For="@(() => detail.Quantity)" class="text-danger small" />
                                                </td>
                                                <td class="text-end font-monospace fw-bold">
                                                    @detail.LineTotal.ToString("C2")
                                                </td>
                                                <td class="text-center">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="@ViewMessages.RemoveProductButton"
                                                            @onclick="() => RemoveDetail(detail)">
                                                        <i class="bi bi-trash"></i> @ViewMessages.RemoveProductButton
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- RESUMEN FINANCIERO Y TOTALES -->
                <div class="row justify-content-end mb-4">
                    <div class="col-md-5 col-lg-4">
                        <div class="card bg-light border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">@ViewMessages.SubtotalAmountLabel</span>
                                    <span class="font-monospace fw-bold">@Model.Subtotal.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">@ViewMessages.TaxAmountLabel</span>
                                    <span class="font-monospace fw-bold">@Model.Tax.ToString("C2")</span>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold text-primary">@ViewMessages.TotalAmountLabel</h5>
                                    <h4 class="mb-0 font-monospace fw-bold text-success">@Model.Total.ToString("C2")</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BOTÓN DE ACCIÓN FINAL -->
                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary btn-lg px-4" disabled="@(_isSubmitting || Model.OrderDetails.Count == 0)">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            @ViewMessages.SubmittingOrderButton
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i> @ViewMessages.SubmitOrderButton
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

<!-- MODALES DE BÚSQUEDA -->
<CustomerSearchModal @bind-IsOpen="_isCustomerModalOpen"
                     OnCustomerSelected="HandleCustomerSelected" />

<ProductSearchModal @bind-IsOpen="_isProductModalOpen"
                    OnProductSelected="HandleProductSelected" />

@code {
    [Parameter]
    public CreateOrderViewModel Model { get; set; } = new();

    [Inject]
    public ICreateOrderGateway OrderGateway { get; set; } = default!;

    private EditContext _editContext = default!;
    private ValidationMessageStore _serverMessageStore = default!;
    private Exception? _currentException;
    private int? _createdOrderId;
    private bool _isSubmitting;

    private bool _isCustomerModalOpen;
    private bool _isProductModalOpen;

    protected override void OnInitialized()
    {
        InitializeEditContext();
    }

    private void InitializeEditContext()
    {
        _editContext = new EditContext(Model);
        _serverMessageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += (s, e) =>
        {
            _serverMessageStore.Clear(e.FieldIdentifier);
            _editContext.NotifyValidationStateChanged();
        };
    }

    private void OpenCustomerModal()
    {
        _isCustomerModalOpen = true;
    }

    private void OpenProductModal()
    {
        _isProductModalOpen = true;
    }

    private void HandleCustomerSelected(CustomerDto customer)
    {
        Model.SetCustomer(customer);
        _serverMessageStore.Clear(_editContext.Field(nameof(Model.CustomerId)));
        _editContext.NotifyValidationStateChanged();
        StateHasChanged();
    }

    private void HandleProductSelected(ProductDto product)
    {
        Model.AddOrUpdateDetail(product.Id, product.Name, product.UnitPrice, 1);
        _editContext.NotifyValidationStateChanged();
        StateHasChanged();
    }

    private void OnQuantityChanged(CreateOrderDetailViewModel detail, ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out var qty))
        {
            Model.UpdateQuantity(detail, qty);
        }
        else
        {
            Model.UpdateQuantity(detail, 1);
        }
        _editContext.NotifyValidationStateChanged();
        StateHasChanged();
    }

    private void RemoveDetail(CreateOrderDetailViewModel detail)
    {
        Model.RemoveDetail(detail);
        _editContext.NotifyValidationStateChanged();
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        _currentException = null;
        _serverMessageStore.Clear();
        _editContext.NotifyValidationStateChanged();
        _isSubmitting = true;

        try
        {
            var dto = Model.ToDto();
            var orderId = await OrderGateway.CreateOrderAsync(dto);
            _createdOrderId = orderId;
        }
        catch (Exception ex)
        {
            _currentException = ex;

            // Inyectar errores devueltos por el backend al ValidationMessageStore del formulario
            if (ex.Data.Contains("Errors") && ex.Data["Errors"] is IEnumerable<ValidationError> validationErrors)
            {
                var errorsList = validationErrors.ToList();
                if (errorsList.Count > 0)
                {
                    foreach (var error in errorsList)
                    {
                        var fieldIdentifier = ModelValidator<CreateOrderViewModel>.ResolveFieldIdentifier(Model, error.PropertyName);
                        var fieldMessage = error.ErrorMessage.Contains("superan las existencias", StringComparison.OrdinalIgnoreCase)
                            ? "Stock insuficiente"
                            : error.ErrorMessage;

                        _serverMessageStore.Add(fieldIdentifier, fieldMessage);
                    }
                    _editContext.NotifyValidationStateChanged();
                }
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _createdOrderId = null;
        _currentException = null;
        Model.Reset();
        InitializeEditContext();
    }
}
