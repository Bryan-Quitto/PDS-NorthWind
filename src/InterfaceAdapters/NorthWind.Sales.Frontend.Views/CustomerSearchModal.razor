@namespace NorthWind.Sales.Frontend.Views
@implements IDisposable

<ModalDialog IsOpen="@IsOpen"
             IsOpenChanged="@IsOpenChanged"
             Title="@ViewMessages.CustomerSearchTitle"
             Size="ModalSize.Large"
             Centered="true"
             Scrollable="true"
             HeaderCssClass="bg-primary text-white"
             OnClose="CloseAsync">
    <HeaderTemplate>
        <h5 class="modal-title">
            <i class="bi bi-people-fill me-2"></i>@ViewMessages.CustomerSearchTitle
        </h5>
    </HeaderTemplate>
    <BodyTemplate>
        <CriteriaSearchBar Criteria="@CustomerCriteria"
                           SelectedCriterionKey="@_selectedCriteria.ToString()"
                           SelectedCriterionKeyChanged="HandleCriterionChangedAsync"
                           @bind-SearchText="_searchTerm"
                           Placeholder="@GetSearchPlaceholder()"
                           MaxLength="@GetSearchMaxLength()"
                           OnSearch="() => SearchAsync(1)"
                           OnClear="ClearSearchAsync"
                           IsSearching="_isLoading"
                           SearchButtonText="@ViewMessages.SearchButton"
                           ClearButtonText="@ViewMessages.ClearButton"
                           ShowClearButton="true"
                           Class="mb-3" />

        @if (_isLoading)
        {
            <LoadingSpinner Text="@ViewMessages.LoadingData" Color="primary" />
        }
        else if (_customers.Count == 0)
        {
            <div class="alert alert-info text-center my-3">
                @ViewMessages.NoRecordsFound
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>@ViewMessages.CustomerNameLabel</th>
                            <th>@ViewMessages.CustomerIdentificationLabel</th>
                            <th class="text-center" style="width: 120px;">@ViewMessages.ActionsLabel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in _customers)
                        {
                            <tr>
                                <td class="fw-bold">@customer.Id</td>
                                <td>
                                    <div>@customer.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(customer.TradeName))
                                    {
                                        <div class="text-muted small"><i class="bi bi-shop me-1"></i>Comercial: @customer.TradeName</div>
                                    }
                                    @if (customer.CustomerType == CustomerType.Legal)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Jurídica</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle small">Natural</span>
                                    }
                                </td>
                                <td>@customer.Identification</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-success px-3"
                                            type="button"
                                            @onclick="() => SelectCustomerAsync(customer)">
                                        @ViewMessages.SelectButton
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <DataPager CurrentPage="@_currentPage"
                       TotalPages="@_totalPages"
                       TotalCount="@_totalCount"
                       ShowPageInfo="true"
                       OnPageChanged="SearchAsync"
                       Class="mt-3 pt-2 border-top" />
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="CloseAsync">
            @ViewMessages.CloseButton
        </button>
    </FooterTemplate>
</ModalDialog>
