@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-box-seam me-2"></i>@ViewMessages.ProductSearchTitle
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group mb-3">
                        <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 px-3 shadow-none"
                                type="button"
                                @onclick="ToggleCriteriaDropdown"
                                aria-expanded="@_isDropdownOpen">
                            <i class="@GetCriteriaIcon(_selectedCriteria) text-success"></i>
                            <span class="fw-semibold">@GetCriteriaLabel(_selectedCriteria)</span>
                        </button>

                        <div class="dropdown-menu shadow @(_isDropdownOpen ? "show" : "")" style="position: absolute; z-index: 1050; top: 100%; left: 0;">
                            <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == ProductSearchCriteria.All ? "active" : "")"
                                    type="button"
                                    @onclick="() => SelectCriteriaAsync(ProductSearchCriteria.All)">
                                <i class="bi bi-grid-fill"></i>
                                <span>@ViewMessages.CriteriaAll</span>
                            </button>
                            <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == ProductSearchCriteria.Name ? "active" : "")"
                                    type="button"
                                    @onclick="() => SelectCriteriaAsync(ProductSearchCriteria.Name)">
                                <i class="bi bi-tag-fill"></i>
                                <span>@ViewMessages.CriteriaProductName</span>
                            </button>
                            <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == ProductSearchCriteria.Id ? "active" : "")"
                                    type="button"
                                    @onclick="() => SelectCriteriaAsync(ProductSearchCriteria.Id)">
                                <i class="bi bi-hash"></i>
                                <span>@ViewMessages.CriteriaProductId</span>
                            </button>
                        </div>

                        <input type="text"
                               class="form-control"
                               placeholder="@GetSearchPlaceholder()"
                               value="@_searchTerm"
                               maxlength="@GetSearchMaxLength()"
                               inputmode="@GetSearchInputMode()"
                               onkeypress="@GetSearchKeyPress()"
                               onpaste="@GetSearchPaste()"
                               @oninput="HandleSearchInput"
                               @onkeydown="HandleKeyDown" />
                        <button class="btn btn-success px-3" type="button" @onclick="() => SearchAsync(1)" disabled="@_isLoading">
                            <i class="bi bi-search me-1"></i>@ViewMessages.SearchButton
                        </button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearchAsync" disabled="@_isLoading">
                            @ViewMessages.ClearButton
                        </button>
                    </div>

                    @if (_isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">@ViewMessages.LoadingData</span>
                            </div>
                            <p class="mt-2 text-muted small">@ViewMessages.LoadingData</p>
                        </div>
                    }
                    else if (_products.Count == 0)
                    {
                        <div class="alert alert-info text-center my-3">
                            @ViewMessages.NoRecordsFound
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>@ViewMessages.ProductNameLabel</th>
                                        <th class="text-end">@ViewMessages.UnitPriceLabel</th>
                                        <th class="text-center">@ViewMessages.StockLabel</th>
                                        <th class="text-center" style="width: 120px;">@ViewMessages.ActionsLabel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in _products)
                                    {
                                        var isExcluded = ExcludedProductId.HasValue && ExcludedProductId.Value == product.Id;
                                        <tr style="@(isExcluded ? "cursor: not-allowed; opacity: 0.6;" : "")" title="@(isExcluded ? "No se puede seleccionar el mismo producto" : "")">
                                            <td class="fw-bold">@product.Id</td>
                                            <td>
                                                @product.Name
                                                @if (isExcluded)
                                                {
                                                    <span class="badge bg-secondary ms-2">Producto actual</span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">@product.UnitPrice.ToString("C2")</td>
                                            <td class="text-center">
                                                <span class="badge @(product.UnitsInStock > 0 ? "bg-success" : "bg-danger")">
                                                    @product.UnitsInStock
                                                </span>
                                            </td>
                                            <td class="text-center" style="@(isExcluded ? "cursor: not-allowed;" : "")">
                                                <button class="btn btn-sm btn-success px-3"
                                                        type="button"
                                                        style="@(isExcluded ? "cursor: not-allowed;" : "")"
                                                        disabled="@(product.UnitsInStock <= 0 || isExcluded)"
                                                        @onclick="() => SelectProductAsync(product)">
                                                    @ViewMessages.SelectButton
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <small class="text-muted">
                                @ViewMessages.TotalRecordsLabel <strong>@_totalCount</strong> | @ViewMessages.PageLabel @_currentPage @ViewMessages.OfLabel @_totalPages
                            </small>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        disabled="@(!HasPreviousPage || _isLoading)"
                                        @onclick="PreviousPageAsync">
                                    &laquo; @ViewMessages.PreviousButton
                                </button>
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        disabled="@(!HasNextPage || _isLoading)"
                                        @onclick="NextPageAsync">
                                    @ViewMessages.NextButton &raquo;
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAsync">
                        @ViewMessages.CloseButton
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<ProductDto> OnProductSelected { get; set; }

    [Parameter]
    public int? ExcludedProductId { get; set; }

    [Inject]
    public ISearchGateway SearchGateway { get; set; } = default!;

    private ProductSearchCriteria _selectedCriteria = ProductSearchCriteria.All;
    private bool _isDropdownOpen = false;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private const int PageSize = 10;
    private int _totalCount = 0;
    private int _totalPages = 1;
    private bool _isLoading = false;
    private IReadOnlyList<ProductDto> _products = [];

    private bool HasPreviousPage => _currentPage > 1;
    private bool HasNextPage => _currentPage < _totalPages;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _products.Count == 0 && !_isLoading)
        {
            await SearchAsync(1);
        }
    }

    private void ToggleCriteriaDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
    }

    private async Task SelectCriteriaAsync(ProductSearchCriteria criteria)
    {
        _selectedCriteria = criteria;
        _isDropdownOpen = false;
        _searchTerm = string.Empty;
        await SearchAsync(1);
    }

    private string GetCriteriaLabel(ProductSearchCriteria criteria) => criteria switch
    {
        ProductSearchCriteria.Name => ViewMessages.CriteriaProductName,
        ProductSearchCriteria.Id => ViewMessages.CriteriaProductId,
        _ => ViewMessages.CriteriaAll
    };

    private string GetCriteriaIcon(ProductSearchCriteria criteria) => criteria switch
    {
        ProductSearchCriteria.Name => "bi bi-tag-fill",
        ProductSearchCriteria.Id => "bi bi-hash",
        _ => "bi bi-grid-fill"
    };

    private string GetSearchPlaceholder() => _selectedCriteria switch
    {
        ProductSearchCriteria.Name => "Buscar por nombre del producto (ej. Chai, Queso)...",
        ProductSearchCriteria.Id => "Buscar por ID numérico de producto (ej. 1, 10)...",
        _ => "Buscar por ID o nombre de producto..."
    };

    private int? GetSearchMaxLength() => _selectedCriteria switch
    {
        ProductSearchCriteria.Id => 10,
        ProductSearchCriteria.Name => 40,
        _ => 40
    };

    private string GetSearchInputMode() => _selectedCriteria switch
    {
        ProductSearchCriteria.Id => "numeric",
        _ => "text"
    };

    private string? GetSearchKeyPress() => _selectedCriteria switch
    {
        ProductSearchCriteria.Id => "return event.key.length > 1 || /^\\d$/.test(event.key)",
        _ => null
    };

    private string? GetSearchPaste() => _selectedCriteria switch
    {
        ProductSearchCriteria.Id => "const text = (event.clipboardData || window.clipboardData).getData('text'); if (!/^\\d*$/.test(text)) { event.preventDefault(); }",
        _ => null
    };

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync(1);
        }
    }

    public async Task SearchAsync(int pageNumber)
    {
        _isLoading = true;
        _currentPage = pageNumber;

        try
        {
            var result = await SearchGateway.SearchProductsAsync(_searchTerm, _selectedCriteria, _currentPage, PageSize);
            _products = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = (int)Math.Ceiling((double)_totalCount / PageSize);
            if (_totalPages < 1) _totalPages = 1;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        _searchTerm = string.Empty;
        await SearchAsync(1);
    }

    private async Task PreviousPageAsync()
    {
        if (HasPreviousPage)
        {
            await SearchAsync(_currentPage - 1);
        }
    }

    private async Task NextPageAsync()
    {
        if (HasNextPage)
        {
            await SearchAsync(_currentPage + 1);
        }
    }

    private async Task SelectProductAsync(ProductDto product)
    {
        await OnProductSelected.InvokeAsync(product);
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        _isDropdownOpen = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
