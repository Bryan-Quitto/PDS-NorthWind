@page "/invoices"
@page "/invoices/{OrderId:int}"
@attribute [Authorize]

<PageTitle>@ViewMessages.InvoiceSearchTitle - NorthWind</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12 col-xl-11 mx-auto">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt-cutoff me-2"></i>@ViewMessages.InvoiceSearchTitle
                    </h5>
                </div>
                <div class="card-body">
                    <ExceptionDisplay Exception="@_currentException" />

                    @if (_selectedInvoice is null)
                    {
                        <!-- PANEL DE BÚSQUEDA DE FACTURAS -->
                        <div class="row mb-3">
                            <div class="col-md-10 col-lg-8">
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 px-3 shadow-none"
                                            type="button"
                                            @onclick="ToggleCriteriaDropdown"
                                            aria-expanded="@_isDropdownOpen">
                                        <i class="@GetCriteriaIcon(_selectedCriteria) text-primary"></i>
                                        <span class="fw-semibold">@GetCriteriaLabel(_selectedCriteria)</span>
                                    </button>

                                    <div class="dropdown-menu shadow @(_isDropdownOpen ? "show" : "")" style="position: absolute; z-index: 1050; top: 100%; left: 0;">
                                        <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == OrderSearchCriteria.All ? "active" : "")"
                                                type="button"
                                                @onclick="() => SelectCriteriaAsync(OrderSearchCriteria.All)">
                                            <i class="bi bi-grid-fill"></i>
                                            <span>@ViewMessages.CriteriaAll</span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == OrderSearchCriteria.OrderId ? "active" : "")"
                                                type="button"
                                                @onclick="() => SelectCriteriaAsync(OrderSearchCriteria.OrderId)">
                                            <i class="bi bi-receipt"></i>
                                            <span>@ViewMessages.CriteriaInvoiceId</span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == OrderSearchCriteria.CustomerName ? "active" : "")"
                                                type="button"
                                                @onclick="() => SelectCriteriaAsync(OrderSearchCriteria.CustomerName)">
                                            <i class="bi bi-person-badge"></i>
                                            <span>@ViewMessages.CriteriaName</span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == OrderSearchCriteria.CustomerIdentification ? "active" : "")"
                                                type="button"
                                                @onclick="() => SelectCriteriaAsync(OrderSearchCriteria.CustomerIdentification)">
                                            <i class="bi bi-card-text"></i>
                                            <span>@ViewMessages.CriteriaIdentification</span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center gap-2 @(_selectedCriteria == OrderSearchCriteria.CustomerId ? "active" : "")"
                                                type="button"
                                                @onclick="() => SelectCriteriaAsync(OrderSearchCriteria.CustomerId)">
                                            <i class="bi bi-key-fill"></i>
                                            <span>@ViewMessages.CriteriaCustomerId</span>
                                        </button>
                                    </div>

                                    <input type="text"
                                           class="form-control"
                                           placeholder="@GetSearchPlaceholder()"
                                           value="@_searchTerm"
                                           @oninput="HandleSearchInput"
                                           @onkeydown="HandleKeyDown" />
                                    <button class="btn btn-primary px-3" type="button" @onclick="() => SearchOrdersAsync(1)" disabled="@_isLoading">
                                        <i class="bi bi-search me-1"></i>@ViewMessages.SearchButton
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearchAsync" disabled="@_isLoading">
                                        @ViewMessages.ClearButton
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (_isLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">@ViewMessages.LoadingData</span>
                                </div>
                                <p class="mt-2 text-muted small">@ViewMessages.LoadingData</p>
                            </div>
                        }
                        else if (_orders.Count == 0)
                        {
                            <div class="alert alert-info text-center my-4 py-4">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                @ViewMessages.NoRecordsFound
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-striped align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 15%;">@ViewMessages.OrderIdColumnLabel</th>
                                            <th style="width: 25%;">@ViewMessages.OrderDateColumnLabel</th>
                                            <th style="width: 30%;">@ViewMessages.CustomerNameLabel</th>
                                            <th style="width: 10%;" class="text-center">@ViewMessages.ItemsCountColumnLabel</th>
                                            <th style="width: 10%;" class="text-end">@ViewMessages.TotalAmountLabel</th>
                                            <th style="width: 10%;" class="text-center">@ViewMessages.ActionsLabel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in _orders)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">#@order.OrderId</td>
                                                <td>@order.OrderDate.ToEcuadorTime().ToString("g")</td>
                                                <td>
                                                    <strong>@order.CustomerName</strong>
                                                    <span class="text-muted small d-block">ID: @order.CustomerId</span>
                                                    <span class="text-muted small d-block">Cédula: @order.CustomerIdentification</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@order.ItemsCount</span>
                                                </td>
                                                <td class="text-end font-monospace fw-bold">
                                                    @order.Total.ToString("C2")
                                                </td>
                                                <td class="text-center">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            disabled="@_isLoadingInvoice"
                                                            @onclick="() => LoadInvoiceAsync(order.OrderId)">
                                                        <i class="bi bi-eye me-1"></i>@ViewMessages.ViewInvoiceButton
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <small class="text-muted">
                                    @ViewMessages.TotalRecordsLabel <strong>@_totalCount</strong> | @ViewMessages.PageLabel @_currentPage @ViewMessages.OfLabel @_totalPages
                                </small>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            disabled="@(!HasPreviousPage || _isLoading)"
                                            @onclick="PreviousPageAsync">
                                        &laquo; @ViewMessages.PreviousButton
                                    </button>
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            disabled="@(!HasNextPage || _isLoading)"
                                            @onclick="NextPageAsync">
                                        @ViewMessages.NextButton &raquo;
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- VISTA DE RECONSTRUCCIÓN DE LA FACTURA -->
                        <div class="p-3 bg-light border rounded mb-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-info text-dark me-2">RIDE / Factura</span>
                                <small class="text-muted">@ViewMessages.ReconstructedInvoiceNotice</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-danger"
                                        disabled="@_isDownloadingPdf"
                                        @onclick="DownloadPdfAsync">
                                    @if (_isDownloadingPdf)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        @ViewMessages.ExportingPdfButton
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-pdf-fill me-1"></i>
                                        @ViewMessages.ExportPdfButton
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="ClearSelectedInvoice">
                                    <i class="bi bi-arrow-left me-1"></i>@ViewMessages.BackToSearchButton
                                </button>
                            </div>
                        </div>

                        <div class="card border shadow-sm p-4">
                            <!-- Cabecera de la factura -->
                            <div class="row border-bottom pb-3 mb-3">
                                <div class="col-md-7">
                                    <h3 class="fw-bold text-primary mb-1">NORTHWIND TRADERS</h3>
                                    <p class="text-muted mb-0 small">Soluciones Comerciales & Distribución</p>
                                    <p class="text-muted mb-0 small">RUC: 1790012345001 | Quito - Ecuador</p>
                                </div>
                                <div class="col-md-5 text-md-end">
                                    <div class="border border-2 border-primary rounded p-2 d-inline-block text-start">
                                        <h5 class="fw-bold text-primary mb-1 text-center">FACTURA ELECTRÓNICA</h5>
                                        <div class="text-center fw-bold fs-5 text-dark mb-1">No. @(_selectedInvoice.OrderId.ToString("D8"))</div>
                                        <small class="d-block text-muted"><strong>Fecha:</strong> @_selectedInvoice.OrderDate.ToEcuadorTime().ToString("g")</small>
                                        <small class="d-block text-warning fw-bold">ESTADO: EN PRUEBAS</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Datos del Cliente y Envío -->
                            <div class="row g-3 bg-light p-3 rounded mb-4">
                                <div class="col-md-6 border-end">
                                    <h6 class="fw-bold text-secondary mb-2">@ViewMessages.CustomerSectionTitle</h6>
                                    <p class="mb-1"><strong>@ViewMessages.CustomerNameLabel:</strong> @_selectedInvoice.CustomerName</p>
                                    <p class="mb-1"><strong>@ViewMessages.CustomerIdentificationLabel:</strong> @_selectedInvoice.CustomerIdentification</p>
                                    <p class="mb-0"><strong>@ViewMessages.CustomerIdLabel:</strong> @_selectedInvoice.CustomerId</p>
                                </div>
                                <div class="col-md-6 ps-md-4">
                                    <h6 class="fw-bold text-secondary mb-2">Datos de Entrega / Envío</h6>
                                    <p class="mb-1"><strong>@ViewMessages.ShipAddressLabel:</strong> @_selectedInvoice.ShipAddress</p>
                                    <p class="mb-1"><strong>@ViewMessages.ShipCityLabel / @ViewMessages.ShipCountryLabel:</strong> @_selectedInvoice.ShipCity, @_selectedInvoice.ShipCountry</p>
                                    <p class="mb-0"><strong>@ViewMessages.ShipPostalCodeLabel:</strong> @_selectedInvoice.ShipPostalCode</p>
                                </div>
                            </div>

                            <!-- Tabla de Detalles de Productos -->
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered table-striped align-middle mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 8%;">@ViewMessages.ProductIdLabel</th>
                                            <th style="width: 47%;">@ViewMessages.ProductNameLabel</th>
                                            <th style="width: 15%;" class="text-end">@ViewMessages.UnitPriceLabel</th>
                                            <th style="width: 15%;" class="text-center">@ViewMessages.QuantityLabel</th>
                                            <th style="width: 15%;" class="text-end">@ViewMessages.SubtotalLineLabel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _selectedInvoice.Details)
                                        {
                                            <tr>
                                                <td class="text-muted">#@item.ProductId</td>
                                                <td>@item.ProductName</td>
                                                <td class="text-end font-monospace">@item.UnitPrice.ToString("C2")</td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end font-monospace fw-bold">@item.LineTotal.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Totales de la Factura -->
                            <div class="row justify-content-end">
                                <div class="col-md-5 col-lg-4">
                                    <div class="card bg-light border-0">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">@ViewMessages.SubtotalAmountLabel</span>
                                                <span class="font-monospace fw-bold">@_selectedInvoice.Subtotal.ToString("C2")</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="text-muted">@ViewMessages.TaxAmountLabel</span>
                                                <span class="font-monospace fw-bold">@_selectedInvoice.Tax.ToString("C2")</span>
                                            </div>
                                            <hr class="my-2" />
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h5 class="mb-0 fw-bold text-primary">@ViewMessages.TotalAmountLabel</h5>
                                                <h4 class="mb-0 font-monospace fw-bold text-success">@_selectedInvoice.Total.ToString("C2")</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? OrderId { get; set; }

    [Inject]
    public IOrderInvoiceGateway InvoiceGateway { get; set; } = default!;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = default!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    private OrderSearchCriteria _selectedCriteria = OrderSearchCriteria.All;
    private bool _isDropdownOpen = false;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private const int PageSize = 10;
    private int _totalCount = 0;
    private int _totalPages = 1;
    private bool _isLoading = false;
    private bool _isLoadingInvoice = false;
    private bool _isDownloadingPdf = false;
    private Exception? _currentException;

    private IReadOnlyList<OrderSummaryDto> _orders = [];
    private OrderInvoiceDto? _selectedInvoice;

    private bool HasPreviousPage => _currentPage > 1;
    private bool HasNextPage => _currentPage < _totalPages;

    protected override async Task OnInitializedAsync()
    {
        await SearchOrdersAsync(1);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId.HasValue && OrderId.Value > 0)
        {
            await LoadInvoiceAsync(OrderId.Value);
        }
    }

    private void ToggleCriteriaDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
    }

    private async Task SelectCriteriaAsync(OrderSearchCriteria criteria)
    {
        _selectedCriteria = criteria;
        _isDropdownOpen = false;
        await SearchOrdersAsync(1);
    }

    private string GetCriteriaLabel(OrderSearchCriteria criteria) => criteria switch
    {
        OrderSearchCriteria.OrderId => ViewMessages.CriteriaInvoiceId,
        OrderSearchCriteria.CustomerName => ViewMessages.CriteriaName,
        OrderSearchCriteria.CustomerIdentification => ViewMessages.CriteriaIdentification,
        OrderSearchCriteria.CustomerId => ViewMessages.CriteriaCustomerId,
        _ => ViewMessages.CriteriaAll
    };

    private string GetCriteriaIcon(OrderSearchCriteria criteria) => criteria switch
    {
        OrderSearchCriteria.OrderId => "bi bi-receipt",
        OrderSearchCriteria.CustomerName => "bi bi-person-badge",
        OrderSearchCriteria.CustomerIdentification => "bi bi-card-text",
        OrderSearchCriteria.CustomerId => "bi bi-key-fill",
        _ => "bi bi-grid-fill"
    };

    private string GetSearchPlaceholder() => _selectedCriteria switch
    {
        OrderSearchCriteria.OrderId => "Buscar por No. de Factura (ej. 10248)...",
        OrderSearchCriteria.CustomerName => "Buscar por Nombre o Razón Social de cliente...",
        OrderSearchCriteria.CustomerIdentification => "Buscar por Cédula o RUC del cliente...",
        OrderSearchCriteria.CustomerId => "Buscar por Código ID de cliente (ej. ALFKI)...",
        _ => "Buscar por No. Factura, Nombre, Cédula o ID de Cliente..."
    };

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchOrdersAsync(1);
        }
    }

    private async Task SearchOrdersAsync(int pageNumber)
    {
        _isLoading = true;
        _currentException = null;
        _currentPage = pageNumber;

        try
        {
            var result = await InvoiceGateway.SearchOrdersAsync(_searchTerm, _selectedCriteria, _currentPage, PageSize);
            _orders = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = (int)Math.Ceiling((double)_totalCount / PageSize);
            if (_totalPages < 1) _totalPages = 1;
        }
        catch (Exception ex)
        {
            _currentException = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        _searchTerm = string.Empty;
        await SearchOrdersAsync(1);
    }

    private async Task PreviousPageAsync()
    {
        if (HasPreviousPage)
        {
            await SearchOrdersAsync(_currentPage - 1);
        }
    }

    private async Task NextPageAsync()
    {
        if (HasNextPage)
        {
            await SearchOrdersAsync(_currentPage + 1);
        }
    }

    private async Task LoadInvoiceAsync(int orderId)
    {
        _isLoadingInvoice = true;
        _currentException = null;

        try
        {
            _selectedInvoice = await InvoiceGateway.GetOrderInvoiceAsync(orderId);
            if (_selectedInvoice is null)
            {
                _currentException = new InvalidOperationException(ViewMessages.InvoiceNotFound);
            }
        }
        catch (Exception ex)
        {
            _currentException = ex;
        }
        finally
        {
            _isLoadingInvoice = false;
        }
    }

    private void ClearSelectedInvoice()
    {
        _selectedInvoice = null;
        _currentException = null;
        if (OrderId.HasValue)
        {
            OrderId = null;
            NavigationManager.NavigateTo("invoices");
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (_selectedInvoice is null) return;

        _isDownloadingPdf = true;
        _currentException = null;

        try
        {
            var pdfBytes = await InvoiceGateway.GetOrderPdfAsync(_selectedInvoice.OrderId);
            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"Factura_NorthWind_{_selectedInvoice.OrderId:D8}.pdf";

            await JSRuntime.InvokeVoidAsync("downloadFileFromByteArray", fileName, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            _currentException = ex;
        }
        finally
        {
            _isDownloadingPdf = false;
        }
    }
}
