@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu Title="NorthWind Sales">
            <NavMenuItem Href="" Match="NavLinkMatch.All" IconClass="oi oi-home">
                Inicio
            </NavMenuItem>
            <AuthorizeView>
                <Authorized>
                    <NavMenuItem Href="createorder" Match="NavLinkMatch.Prefix" IconClass="oi oi-plus">
                        Nueva Orden
                    </NavMenuItem>
                </Authorized>
            </AuthorizeView>
        </NavMenu>
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-secondary small">NorthWind Clean Architecture .NET 10</span>
            <div>
                <NorthWind.Membership.Frontend.RazorViews.Components.LoginDisplayComponent />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
