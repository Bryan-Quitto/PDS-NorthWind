{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NorthWindDB": "Server=(localdb)\\mssqllocaldb;Database=NorthWind;Trusted_Connection=True;MultipleActiveResultSets=true",
    "NorthWindDomainLogsDB": "Server=(localdb)\\mssqllocaldb;Database=NorthWindDomainLogs;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "From": "noreply@northwind.com",
    "EnableSsl": false
  }
}
