@page "/"

<PageTitle>Inicio - NorthWind Sales</PageTitle>

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-primary">NorthWind Sales Management</h1>
        <p class="col-md-8 fs-4 text-muted">
            Sistema empresarial implementado con Clean Architecture y .NET 10.
        </p>
        <AuthorizeView>
            <Authorized>
                <a class="btn btn-primary btn-lg px-4" href="createorder" role="button">
                    Registrar Nueva Orden
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary btn-lg px-4" href="user/login" role="button">
                    Iniciar Sesión para Ordenar
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
